---
/**
 * Impressions — Combined photo gallery + Instagram CTA.
 * Replaces separate PhotoScroll + Gallery sections.
 * Shows best photos in a bold grid with Instagram link.
 */
import content from '../data/content.json'
const { instagram } = content

const photos = [
  { src: '/images/barista-cycling.webp', alt: 'Barista bei kudos to you mit Fahrrad-Kultur', span: 'lg:col-span-2' },
  { src: '/images/aussenansicht.webp', alt: 'kudos to you Café Außenansicht in der Colmantstraße Bonn', span: '' },
  { src: '/images/croissants-latte.webp', alt: 'Frische Croissants und Latte Art bei kudos to you', span: '' },
]
---

<section id="gallery" class="relative overflow-hidden bg-brand-espresso py-(--spacing-section)">
  <div class="grain absolute inset-0"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-6">
    <!-- Section header -->
    <div class="reveal flex items-center gap-4">
      <div class="h-[2px] w-12 bg-brand-sage"></div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-sage">Eindrücke</p>
    </div>

    <div class="reveal mt-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <h2 class="font-heading text-4xl font-bold text-brand-cream sm:text-5xl lg:text-6xl">
        Atmosphäre
      </h2>
      <p class="font-accent text-lg text-brand-muted">Mehr auf Instagram ↗</p>
    </div>

    <!-- Photo grid — asymmetric for visual interest -->
    <div class="reveal mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {photos.map((photo) => (
        <div class:list={["photo-grain overflow-hidden rounded-2xl", photo.span]}>
          <img
            src={photo.src}
            alt={photo.alt}
            class="h-64 w-full object-cover transition-transform duration-700 hover:scale-[1.03] sm:h-72 lg:h-80"
            loading="lazy"
            width="800"
            height="600"
          />
        </div>
      ))}
    </div>

    <!-- Instagram CTA — replaces old Gallery consent section -->
    <div class="reveal mt-12 flex flex-col items-center gap-6 text-center sm:flex-row sm:justify-between sm:text-left">
      <div>
        <p class="text-lg text-brand-cream/80">
          Mehr Einblicke, Community Rides und Café-Momente
        </p>
        <p class="mt-1 font-accent text-base text-brand-sage">
          {instagram.description}
        </p>
      </div>
      <a
        href={instagram.profileUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex shrink-0 items-center gap-3 rounded-full bg-brand-cream px-7 py-3.5 transition-all duration-300 hover:shadow-lg hover:shadow-brand-cream/10"
      >
        <svg class="h-5 w-5 text-brand-espresso" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        <span class="text-sm font-semibold text-brand-espresso">@{instagram.handle} folgen</span>
      </a>
    </div>
  </div>
</section>
