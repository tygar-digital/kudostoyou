---
import content from '../data/content.json'
import { cupPerson, sparkle, coffeeBean, sketchyHeart } from './Sketches.astro'
const { hero } = content
---

<section class="relative flex min-h-[100svh] flex-col justify-center overflow-hidden bg-brand-cream" id="heroSection">
  <!-- Paper texture + grain -->
  <div class="paper-texture absolute inset-0"></div>
  <div class="grain absolute inset-0"></div>

  <!-- Floating sketch elements -->
  <div class="absolute right-[8%] top-[12%] w-10 opacity-[0.10] -rotate-6 hidden lg:block" data-parallax="-0.08" set:html={coffeeBean} />
  <div class="absolute left-[6%] top-[18%] w-16 opacity-[0.10] -rotate-12 hidden lg:block" data-parallax="-0.05" set:html={sketchyHeart} />
  <div class="absolute left-[12%] bottom-[14%] w-8 opacity-[0.08] rotate-45 hidden lg:block" data-parallax="-0.03" set:html={sparkle} />
  <div class="absolute right-[14%] bottom-[22%] w-7 opacity-[0.08] rotate-12 hidden lg:block" data-parallax="-0.06" set:html={sparkle} />

  <!-- Sage green glow — top right -->
  <div class="absolute -right-20 -top-20 h-80 w-80 rounded-full bg-brand-sage/[0.06] blur-3xl" data-parallax="-0.04"></div>
  <!-- Warm glow — bottom left -->
  <div class="absolute -left-16 bottom-0 h-64 w-64 rounded-full bg-brand-muted/[0.08] blur-3xl" data-parallax="-0.03"></div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-6 pt-28 pb-20 lg:pt-20 lg:pb-12">

    <!-- Location tag — small, top center -->
    <p class="hero-text-1 text-center font-accent text-lg text-brand-sage sm:text-xl lg:text-left lg:pl-1">
      {hero.location}
    </p>

    <!-- Main hero layout: Mobile = stacked centered, Desktop = grid with typo left + cupman centered-right -->
    <div class="mt-4 flex flex-col items-center lg:mt-2 lg:grid lg:grid-cols-[1fr_1fr] lg:items-end lg:gap-0">

      <!-- Typo block — left-aligned on desktop, centered on mobile -->
      <div class="order-2 mt-2 text-center lg:order-1 lg:mt-0 lg:text-left">
        <div class="hero-text-2">
          <h1 class="font-heading text-[4.5rem] font-bold leading-[0.82] tracking-tighter text-brand-text sm:text-[6rem] md:text-[7rem] lg:text-[8rem] xl:text-[9.5rem]">
            kudos
          </h1>
          <p class="hero-text-3 mt-0 font-accent text-3xl text-brand-sage sm:text-4xl lg:text-5xl">
            to you
          </p>
        </div>

        <p class="hero-text-3 mt-3 text-base font-medium tracking-wide text-brand-muted sm:text-lg lg:text-xl">
          {hero.subheadline}
        </p>

        <!-- Hand-drawn sage divider -->
        <svg class="hero-text-3 mx-auto mt-4 h-[3px] w-24 lg:mx-0" viewBox="0 0 100 3" fill="none">
          <path d="M0 2 C20 0.5, 35 2.5, 50 1 C65 -0.5, 80 2.5, 100 1" stroke="#6B4226" stroke-width="2" stroke-linecap="round"/>
        </svg>

        <!-- CTAs -->
        <div class="hero-text-5 mt-5 flex flex-col gap-3 sm:flex-row sm:justify-center lg:justify-start">
          <a
            href={hero.cta.href}
            class="group inline-flex h-13 items-center gap-2 rounded-full bg-brand-sage px-8 text-base font-semibold text-white transition-all duration-300 hover:brightness-90 hover:shadow-lg hover:shadow-brand-sage/20"
          >
            {hero.cta.label}
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="#menu"
            class="inline-flex h-13 items-center rounded-full border-2 border-brand-text px-8 text-base font-medium text-brand-text transition-all duration-300 hover:bg-brand-text hover:text-white"
          >
            Unser Menü
          </a>
        </div>
      </div>

      <!-- Cupman — centered in the remaining space on desktop -->
      <div class="hero-mascot order-1 min-w-0 lg:order-2 lg:flex lg:items-end lg:justify-center" id="hero-parallax-zone">
        <div id="hero-mascot-wrapper" class="flex justify-center">
          <div class="w-48 shrink-0 sm:w-56 md:w-64 lg:w-72 xl:w-[340px]" set:html={cupPerson} />
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-6 left-1/2 z-10 -translate-x-1/2">
    <div class="hero-text-5 flex flex-col items-center gap-2">
      <span class="font-accent text-sm text-brand-muted">Scroll</span>
      <div class="h-8 w-[1px] animate-pulse bg-gradient-to-b from-brand-sage to-transparent"></div>
    </div>
  </div>
</section>

<script>
  // Mouse-tracking parallax for hero cup-person and floating elements
  const heroSection = document.getElementById('heroSection')
  const mascotWrapper = document.getElementById('hero-mascot-wrapper')

  if (heroSection && mascotWrapper && window.matchMedia('(min-width: 1024px)').matches) {
    let mouseX = 0, mouseY = 0
    let currentX = 0, currentY = 0
    let raf = 0

    heroSection.addEventListener('mousemove', (e) => {
      const rect = heroSection.getBoundingClientRect()
      mouseX = (e.clientX - rect.left - rect.width / 2) / rect.width
      mouseY = (e.clientY - rect.top - rect.height / 2) / rect.height
      if (!raf) raf = requestAnimationFrame(smoothFollow)
    })

    heroSection.addEventListener('mouseleave', () => {
      mouseX = 0
      mouseY = 0
      if (!raf) raf = requestAnimationFrame(smoothFollow)
    })

    function smoothFollow() {
      raf = 0
      currentX += (mouseX - currentX) * 0.06
      currentY += (mouseY - currentY) * 0.06

      // Move mascot opposite direction for depth illusion
      mascotWrapper.style.transform = `translate(${currentX * -25}px, ${currentY * -18}px)`

      // Move floating sketch elements in hero
      const heroSketches = heroSection.querySelectorAll('[data-parallax]')
      heroSketches.forEach(el => {
        const speed = parseFloat(el.getAttribute('data-parallax') || '0') * 100
        ;(el as HTMLElement).style.transform = `translate(${currentX * speed}px, ${currentY * speed}px)`
      })

      if (Math.abs(mouseX - currentX) > 0.0005 || Math.abs(mouseY - currentY) > 0.0005) {
        raf = requestAnimationFrame(smoothFollow)
      }
    }
  }
</script>
