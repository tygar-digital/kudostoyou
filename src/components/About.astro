---
import content from '../data/content.json'
import { sparkle, sketchyHeart } from './Sketches.astro'
const { about } = content
---

<section id="about" class="relative overflow-hidden bg-brand-cream">
  <div class="paper-texture absolute inset-0"></div>

  <!-- Subtle sketch accents -->
  <div class="absolute right-[4%] top-[8%] w-7 opacity-[0.15] rotate-12 hidden lg:block" set:html={sparkle} />

  <div class="relative z-10 mx-auto max-w-7xl px-6 py-(--spacing-section)">
    <!-- Section label -->
    <div class="reveal flex items-center gap-4">
      <div class="h-[2px] w-12 bg-brand-sage"></div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand-sage">
        {about.sectionLabel}
      </p>
    </div>

    <!-- Image + text -->
    <div class="mt-10 grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-end lg:gap-20">
      <!-- Image column -->
      <div class="reveal min-w-0">
        <div class="photo-grain overflow-hidden rounded-2xl shadow-xl">
          <img
            src="/images/aufsteller-logo.webp"
            alt="kudos to you Aufsteller im Abendlicht mit Herzlogo und Slogan"
            class="aspect-[4/3] w-full object-cover sm:aspect-[3/4]"
            loading="lazy"
            width="1000"
            height="1333"
          />
        </div>
        <p class="mt-4 text-center font-accent text-base text-brand-muted lg:hidden">
          „Home of coffee and cycling culture" ↗
        </p>
      </div>

      <!-- Text column — bolder typography, no cards -->
      <div>
        <div class="reveal">
          <h2 class="font-heading text-4xl font-bold leading-[0.95] text-brand-text sm:text-5xl lg:text-6xl xl:text-7xl">
            {about.headline}
          </h2>
          <p class="mt-8 text-lg leading-relaxed text-brand-text sm:text-xl">
            {about.text}
          </p>
        </div>

        <!-- Hand-drawn sage divider + heart -->
        <div class="reveal my-10 flex items-center gap-4">
          <svg class="h-[2px] flex-1 opacity-20" viewBox="0 0 400 2" fill="none" preserveAspectRatio="none">
            <path d="M0 1 C60 0.3, 120 1.8, 200 0.8 C280 -0.2, 340 1.6, 400 1" stroke="#6B4226" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <div class="w-8 shrink-0 opacity-15 -rotate-[8deg] text-brand-sage [&_path]:!stroke-brand-sage" set:html={sketchyHeart} />
          <svg class="h-[2px] flex-1 opacity-20" viewBox="0 0 400 2" fill="none" preserveAspectRatio="none">
            <path d="M0 1 C60 0.3, 120 1.8, 200 0.8 C280 -0.2, 340 1.6, 400 1" stroke="#6B4226" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </div>

        <!-- Second text block — Caveat handwriting accent -->
        <div class="reveal">
          <p class="font-accent text-2xl leading-relaxed text-brand-sage sm:text-3xl">
            {about.text2}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
